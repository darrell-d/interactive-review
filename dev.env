# Local development env vars. Mirrors what the platform injects in production.

# Standard processor env vars
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
EXECUTION_RUN_ID=local-review-001

# Interactive-session env var (the platform sets it from app.yml's sessionType)
SESSION_TYPE=webapp

# The app's parameter (app.yml). Short locally so the idle path is easy to try.
IDLE_TIMEOUT_SECONDS=900
